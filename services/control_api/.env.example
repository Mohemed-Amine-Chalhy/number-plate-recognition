# Local SQLite file. Relative paths are resolved from the launching process.
CONTROL_API_DB_PATH=.runtime/campus-control.sqlite3

# The seeded records are fictional and intended only for the portfolio demo.
CONTROL_API_SEED_DEMO=true

# Bind to 0.0.0.0 inside a container. The local default is 127.0.0.1:8000.
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8000

# Optional override for the same-origin static console directory.
# CAMPUS_CONSOLE_DIR=../../web/console

# Comma-separated development origins. The same-origin mounted console needs no CORS.
CONTROL_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
