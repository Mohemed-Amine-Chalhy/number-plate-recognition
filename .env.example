# Environment-variable template for local and container runs. Copy this file to .env and override
# only what you need. Relative local paths use the repository root.

# Campus control API and same-origin web console
# Local execution binds to loopback. Docker Compose overrides the container bind to 0.0.0.0 while
# continuing to publish only on host loopback.
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8000
CONTROL_API_DB_PATH=.runtime/platform/campus-control.sqlite3
CONTROL_API_SEED_DEMO=true
CAMPUS_CONSOLE_DIR=web/console

# Same-origin console deployments do not require CORS. Add only explicit development origins,
# separated by commas, when a separately hosted frontend needs API access.
CONTROL_API_CORS_ORIGINS=

# The current API uses documented demo identities rather than a runtime secret. A production auth
# adapter should receive its issuer, audience, and credentials from the deployment environment.

# Legacy computer-vision / Streamlit application

# Runtime root
NPR_APP_ROOT=.

# Model registry and artifacts
NPR_MODEL_DIR=models
NPR_MODEL_MANIFEST=models/manifest.json
NPR_IMAGE_DIR=images

# Inference device: cpu, cuda, cuda:0, mps, or auto. CPU is the reproducible default.
NPR_DEVICE=cpu

# Stage-specific confidence thresholds (0.0 to 1.0)
NPR_VEHICLE_CONFIDENCE=0.40
NPR_PLATE_CONFIDENCE=0.35
NPR_CHARACTER_CONFIDENCE=0.35
NPR_CHARACTER_OVERLAP_IOU=0.50
NPR_PLATE_DEDUP_IOU=0.50
NPR_VEHICLE_CLASSES=2,3,5,7
NPR_PLATE_PATTERN=^[0-9]{1,5}[ABEDH][0-9]{1,2}$

# Input safety limits
NPR_INFERENCE_MAX_DIMENSION=1024
NPR_MAX_UPLOAD_BYTES=10485760
NPR_MAX_IMAGE_PIXELS=25000000
NPR_MAX_FILES=10
NPR_MAX_VEHICLES=20
NPR_MAX_PLATES_PER_VEHICLE=2
NPR_MAX_CHARACTERS_PER_PLATE=12
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=10

# Application behavior
NPR_LOG_LEVEL=INFO
NPR_VERIFY_MODELS=true
YOLO_AUTOINSTALL=false
YOLO_OFFLINE=true
